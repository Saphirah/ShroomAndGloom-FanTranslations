<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><AssemblyName>ShroomGerman</AssemblyName>
    <Version>0.1.3</Version><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LoaderDir>$(MSBuildProjectDirectory)/../../.tools/loader</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(LoaderDir)/BepInEx/core/*.dll" Exclude="$(LoaderDir)/BepInEx/core/dobby.dll"><Private>false</Private></Reference>
    <Reference Include="$(LoaderDir)/BepInEx/interop/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
